{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${GHOSTDECK_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && ghostdeck --json hooks codex session-start || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "GhostDeck Codex session restore",
            "timeout": 5
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${GHOSTDECK_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && ghostdeck --json hooks codex prompt-submit || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "GhostDeck Codex session restore",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ \"${GHOSTDECK_CODEX_HOOKS_DISABLED:-}\" != \"1\" ] && ghostdeck --json hooks codex stop || echo '{\"continue\":true,\"suppressOutput\":false}'",
            "statusMessage": "GhostDeck Codex session restore",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
